# ---------------------------------------------------------------------------
# Example configuration. Copy to .env and fill in your own values.
#   Windows CMD:  copy .env.example .env
#
# This file contains PLACEHOLDERS ONLY. Never commit a real API key.
# ---------------------------------------------------------------------------

# --- DeepSeek API (only used from stage 3 onwards; stage 1 never calls an LLM) ---
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# Stage 3 real provider reads this key ONLY from the process environment.
# A key in .env alone does not enable real calls. CLI defaults to --provider fake.
# OpenAI-compatible endpoint (see https://api-docs.deepseek.com/)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model name is read from config; it is never hard-coded in application logic.
DEEPSEEK_MODEL=deepseek-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048
ANALYSIS_REFERENCE_DATE=2024-12-31

# --- Databases ---
# Business data: created by the build script, opened READ-ONLY by the app.
BUSINESS_DB_PATH=data/business.db
# LangGraph checkpoints: written by the application only.
# The model never sees or queries this database.
CHECKPOINT_DB_PATH=data/checkpoints.db

# --- Reproducible demo data generation (fixed, machine-date independent) ---
DEMO_SEED=20240101
DEMO_START_DATE=2024-01-01
DEMO_END_DATE=2024-12-31

# --- Read-only SQL execution limits (enforced from stage 2 onwards) ---
# In-process budgets only; not a hard OS sandbox.
SQL_MAX_ROWS=1000
SQL_TIMEOUT_SECONDS=10
SQL_MAX_SQL_CHARS=8000
SQL_MAX_RESULT_BYTES=256000
# SQLITE_LIMIT_LENGTH is a byte budget for strings/blobs, not a character count.
SQL_MAX_VALUE_BYTES=4096

# --- Test switches ---
# Leave false. Live LLM tests must be started explicitly by a human,
# so that the automated test suite never makes a paid external call.
ENABLE_LIVE_LLM_TESTS=false
